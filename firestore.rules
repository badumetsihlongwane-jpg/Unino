rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'admin@mynwu.ac.za' ||
        request.auth.token.admin == true
      );
    }

    // ─── USERS ──────────────────────────────────────
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isUser(userId)
        && !('manualVerified' in request.resource.data)
        && !('isAdmin' in request.resource.data);
      allow update: if (
        isUser(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['manualVerified', 'isVerified', 'isAdmin'])
      ) || isAdmin();
      allow delete: if isUser(userId) || isAdmin();

      match /pushTokens/{tokenId} {
        allow read, write: if isUser(userId) || isAdmin();
      }

      match /notifications/{notifId} {
        allow read: if isUser(userId) || isAdmin();
        allow create: if isAuthenticated();
        allow update, delete: if isUser(userId) || isAdmin();
      }
    }

    // ─── POSTS & FEED ───────────────────────────────
    match /posts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update: if (
        isAuthenticated() && (
          resource.data.authorId == request.auth.uid ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'likesCount', 'commentsCount', 'likes', 'reactions', 'reactionsMap', 'reactionsCount', 'reports', 'savedBy'
          ])
        )
      ) || isAdmin();
      allow delete: if (isAuthenticated() && resource.data.authorId == request.auth.uid) || isAdmin();

      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
        allow update: if (
          isAuthenticated() && (
            resource.data.authorId == request.auth.uid ||
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'likesCount', 'reactions', 'reactionsMap', 'reactionsCount', 'repliesCount', 'reports'
            ])
          )
        ) || isAdmin();
        allow delete: if (
          isAuthenticated() && (
            resource.data.authorId == request.auth.uid ||
            get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid
          )
        ) || isAdmin();
      }

      match /likes/{likeId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isAuthenticated() && (request.auth.uid == likeId || isAdmin());
      }
    }

    // ─── DIRECT MESSAGES & CONVERSATIONS ────────────
    match /conversations/{convoId} {
      allow read: if isAuthenticated() && (request.auth.uid in resource.data.participants || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.participants;
      allow update: if isAuthenticated() && (request.auth.uid in resource.data.participants || isAdmin());
      allow delete: if isAdmin();

      match /messages/{msgId} {
        allow read: if isAuthenticated() && (
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(convoId)).data.participants ||
          isAdmin()
        );
        allow create: if isAuthenticated() && (
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(convoId)).data.participants
        ) && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if (isAuthenticated() && resource.data.senderId == request.auth.uid) || isAdmin();
      }
    }

    // ─── HUSTLE / MARKETPLACE ───────────────────────
    match /listings/{listingId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.sellerId == request.auth.uid;
      allow update, delete: if (isAuthenticated() && resource.data.sellerId == request.auth.uid) || isAdmin();
    }

    // ─── STORIES ────────────────────────────────────
    match /stories/{storyId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update: if (
        isAuthenticated() && (
          resource.data.authorId == request.auth.uid ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewers', 'likes', 'viewersCount', 'likesCount'])
        )
      ) || isAdmin();
      allow delete: if (isAuthenticated() && resource.data.authorId == request.auth.uid) || isAdmin();
    }

    // ─── GROUPS & STUDY HUBS ────────────────────────
    match /groups/{groupId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if (
        isAuthenticated() && (
          request.auth.uid == resource.data.ownerId ||
          request.auth.uid in resource.data.members ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'members', 'requests', 'membersCount', 'lastMessage', 'lastMessageAt'
          ])
        )
      ) || isAdmin();
      allow delete: if (isAuthenticated() && resource.data.ownerId == request.auth.uid) || isAdmin();

      match /messages/{msgId} {
        allow read: if isAuthenticated() && (
          request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members ||
          isAdmin()
        );
        allow create: if isAuthenticated() && (
          request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members
        ) && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if (isAuthenticated() && resource.data.senderId == request.auth.uid) || isAdmin();
      }
    }

    // ─── ASSIGNMENT GROUPS ──────────────────────────
    match /assignmentGroups/{groupId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if (
        isAuthenticated() && (
          request.auth.uid == resource.data.ownerId ||
          request.auth.uid in resource.data.members ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'members', 'requests', 'membersCount', 'lastMessage', 'lastMessageAt'
          ])
        )
      ) || isAdmin();
      allow delete: if (isAuthenticated() && resource.data.ownerId == request.auth.uid) || isAdmin();

      match /messages/{msgId} {
        allow read: if isAuthenticated() && (
          request.auth.uid in get(/databases/$(database)/documents/assignmentGroups/$(groupId)).data.members ||
          isAdmin()
        );
        allow create: if isAuthenticated() && (
          request.auth.uid in get(/databases/$(database)/documents/assignmentGroups/$(groupId)).data.members
        ) && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if (isAuthenticated() && resource.data.senderId == request.auth.uid) || isAdmin();
      }
    }

    // ─── CAMPUS EVENTS ──────────────────────────────
    match /events/{eventId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if (
        isAuthenticated() && (
          resource.data.authorId == request.auth.uid ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendees', 'attendeesCount'])
        )
      ) || isAdmin();
      allow delete: if (isAuthenticated() && resource.data.authorId == request.auth.uid) || isAdmin();
    }

    // ─── STATS ──────────────────────────────────────
    match /stats/{doc} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // ─── LIVE STREAMS & SIGNALS ─────────────────────
    match /liveStreams/{streamId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.hostUid == request.auth.uid;
      allow update, delete: if (
        isAuthenticated() && (
          resource.data.hostUid == request.auth.uid ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewersCount', 'status'])
        )
      ) || isAdmin();

      match /signals/{signalId} {
        allow read, write: if isAuthenticated();
      }

      match /comments/{commentId} {
        allow read, create: if isAuthenticated();
        allow update, delete: if (isAuthenticated() && resource.data.senderUid == request.auth.uid) || isAdmin();
      }
    }

    // ─── REPORTS & MODERATION ───────────────────────
    match /reports/{reportId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAdmin();
    }
  }
}
